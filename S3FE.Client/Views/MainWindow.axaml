<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:S3FE.Client.ViewModels"
        xmlns:controls="using:S3FE.Client.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1180"
        d:DesignHeight="760"
        x:Class="S3FE.Client.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="S3 File Explorer"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        Background="#141218">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Styles>
        <StyleInclude Source="/Controls/Styles.axaml" />
    </Window.Styles>

    <Grid RowDefinitions="Auto,*" Margin="24" RowSpacing="20">
        <controls:ConnectionForm Grid.Row="0" />

        <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="0">
            <controls:BucketSidebar Grid.Column="0" />

            <Border Grid.Column="1"
                    Padding="20"
                    CornerRadius="28"
                    Background="#211F26"
                    BorderBrush="#49454F"
                    BorderThickness="1">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Browser"
                                       FontSize="22"
                                       FontWeight="SemiBold"
                                       Foreground="#E6E1E5" />
                            <TextBlock Text="Open a bucket tab to inspect files at the bucket root."
                                       FontSize="13"
                                       Foreground="#CAC4D0"
                                       IsVisible="{Binding IsConnected}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="10"
                                    VerticalAlignment="Center">
                            <Button Classes="secondary"
                                    Content="↑ Upload"
                                    Command="{Binding UploadFileCommand}"
                                    IsVisible="{Binding IsUploadVisible}" />
                            <ProgressBar Width="180"
                                         Height="6"
                                         IsIndeterminate="True"
                                         IsVisible="{Binding IsConnecting}" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            CornerRadius="24"
                            Background="#1D1B20"
                            BorderBrush="#49454F"
                            BorderThickness="1"
                            IsVisible="{Binding !IsConnected}">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Width="420"
                                    Spacing="12">
                            <TextBlock Text="Connect to MinIO"
                                       FontSize="26"
                                       FontWeight="SemiBold"
                                       Foreground="#E6E1E5"
                                       TextAlignment="Center" />
                            <TextBlock Text="After connecting, buckets will appear on the left and each bucket will open as a tab on the right."
                                       FontSize="14"
                                       Foreground="#CAC4D0"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <TabControl Grid.Row="1"
                                ItemsSource="{Binding BucketTabs}"
                                SelectedItem="{Binding SelectedBucketTab}"
                                Background="Transparent"
                                IsVisible="{Binding IsConnected}">
                        <TabControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BucketTabViewModel">
                                <Grid>
                                    <Border Padding="14,6"
                                            Margin="2,0"
                                            CornerRadius="10"
                                            Background="#2B2930"
                                            IsVisible="{Binding !IsSelected}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{Binding BucketName}"
                                                       Foreground="#CAC4D0"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Classes="tab-close"
                                                    Content="×"
                                                    Command="{Binding CloseCommand}" />
                                        </Grid>
                                    </Border>

                                    <Border Padding="14,6"
                                            Margin="2,0"
                                            CornerRadius="10"
                                            Background="#6750A4"
                                            IsVisible="{Binding IsSelected}">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBlock Text="{Binding BucketName}"
                                                       Foreground="#FFFFFF"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Classes="tab-close"
                                                    Content="×"
                                                    Command="{Binding CloseCommand}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </TabControl.ItemTemplate>

                        <TabControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:BucketTabViewModel">
                                <controls:ObjectTabContent />
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</Window>
