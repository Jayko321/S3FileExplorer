<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="S3FE.Client.Dialogs.RenameObjectDialog"
        Title="Rename object"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#211F26"
        Padding="24">
    <Window.Styles>
        <StyleInclude Source="/Controls/Styles.axaml" />
    </Window.Styles>
    <StackPanel Spacing="16">
        <StackPanel Spacing="4">
            <TextBlock Text="Rename object"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#E6E1E5" />
            <TextBlock Text="Enter a new key (path) for the object."
                       FontSize="13"
                       Foreground="#CAC4D0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBox x:Name="DestinationKeyTextBox"
                 PlaceholderText="new/path/file.txt" />

        <StackPanel x:Name="VersioningPanel"
                    Spacing="8"
                    IsVisible="False">
            <RadioButton x:Name="LatestOnlyRadio"
                         Content="Rename latest version only"
                         IsChecked="True"
                         Foreground="#CAC4D0"
                         FontSize="13" />
            <RadioButton x:Name="AllVersionsRadio"
                         Content="Rename all versions"
                         Foreground="#CAC4D0"
                         FontSize="13" />
        </StackPanel>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Classes="secondary"
                    Content="Cancel"
                    Click="OnCancelClick" />
            <Button Classes="primary"
                    Content="Rename"
                    Click="OnRenameClick" />
        </StackPanel>
    </StackPanel>
</Window>
