<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Class="S3FE.Client.Dialogs.UploadObjectDialog"
        Title="Upload file"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Background="#211F26"
        Padding="24">
    <Window.Styles>
        <StyleInclude Source="/Controls/Styles.axaml" />
    </Window.Styles>
    <StackPanel Spacing="16">
        <StackPanel Spacing="4">
            <TextBlock Text="Upload file"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#E6E1E5" />
            <TextBlock Text="Enter a prefix (folder path) or leave empty to upload at the bucket root."
                       FontSize="13"
                       Foreground="#CAC4D0"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="FileNameText"
                       FontSize="12"
                       Foreground="#D0BCFF"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBox x:Name="PrefixTextBox"
                 PlaceholderText="folder/subfolder/" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Classes="secondary"
                    Content="Cancel"
                    Click="OnCancelClick" />
            <Button Classes="primary"
                    Content="Upload"
                    Click="OnUploadClick" />
        </StackPanel>
    </StackPanel>
</Window>
