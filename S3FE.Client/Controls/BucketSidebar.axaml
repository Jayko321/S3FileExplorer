<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:S3FE.Client.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="S3FE.Client.Controls.BucketSidebar"
             x:DataType="vm:MainWindowViewModel"
             Width="280"
             IsVisible="{Binding IsConnected}">
    <Border Margin="0,0,20,0"
            Padding="20"
            CornerRadius="28"
            Background="#211F26"
            BorderBrush="#49454F"
            BorderThickness="1">
        <DockPanel>
            <StackPanel DockPanel.Dock="Top" Spacing="12" Margin="0,0,0,16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Buckets"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="#E6E1E5" />
                    <TextBlock Text="Available storage buckets"
                               FontSize="13"
                               Foreground="#CAC4D0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Classes="secondary"
                            Content="Add bucket"
                            Command="{Binding OpenCreateBucketPopupCommand}"
                            HorizontalContentAlignment="Center" />
                    <Button Classes="destructive"
                            Content="Delete"
                            Command="{Binding RequestDeleteBucketCommand}"
                            HorizontalContentAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <ListBox ItemsSource="{Binding Buckets}"
                     SelectedItem="{Binding SelectedBucket}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:BucketItemViewModel">
                        <Border Padding="14,12"
                                Margin="0,4"
                                CornerRadius="18"
                                Background="#2B2930">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Border Width="10"
                                        Height="10"
                                        CornerRadius="5"
                                        Background="#D0BCFF"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsSelected}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           Foreground="#E6E1E5"
                                           FontSize="14"
                                           TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="2"
                                        Padding="6,2"
                                        CornerRadius="8"
                                        Background="#6750A4"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding IsVersioned}">
                                    <TextBlock Text="V"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="#FFFFFF" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
