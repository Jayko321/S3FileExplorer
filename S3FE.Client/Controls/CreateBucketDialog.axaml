<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:S3FE.Client.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="S3FE.Client.Controls.CreateBucketDialog"
             x:DataType="vm:MainWindowViewModel"
             IsVisible="{Binding IsCreateBucketPopupOpen}">
    <Border Background="#AA000000">
        <Border Width="420"
                Padding="24"
                CornerRadius="24"
                Background="#211F26"
                BorderBrush="#49454F"
                BorderThickness="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <StackPanel Spacing="16">
                <StackPanel Spacing="4">
                    <TextBlock Text="Create bucket"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="#E6E1E5" />
                    <TextBlock Text="Enter a new bucket name. Bucket names should be lowercase and S3-compatible."
                               FontSize="13"
                               Foreground="#CAC4D0"
                               TextWrapping="Wrap" />
                </StackPanel>

                <TextBox Text="{Binding NewBucketName}"
                         PlaceholderText="new-bucket-name" />

                <CheckBox IsChecked="{Binding CreateVersioned}"
                          Content="Enable object versioning"
                          Foreground="#CAC4D0"
                          FontSize="13" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="8">
                    <Button Classes="secondary"
                            Content="Cancel"
                            Command="{Binding CancelCreateBucketCommand}" />
                    <Button Classes="primary"
                            Content="Create"
                            Command="{Binding AddBucketCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</UserControl>
