<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:S3FE.Client.ViewModels"
             xmlns:models="using:S3FE.Client.Models"
             xmlns:conv="using:S3FE.Client.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             x:Class="S3FE.Client.Controls.ObjectTabContent"
             x:DataType="vm:BucketTabViewModel">
    <UserControl.Resources>
        <conv:BoolToOpacityConverter x:Key="BoolToOpacity" />
        <conv:BytesToHumanReadableConverter x:Key="BytesToHumanReadable" />
        <conv:DateTimeFormatConverter x:Key="DateTimeFormat" />
    </UserControl.Resources>
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" ColumnDefinitions="*,Auto" RowSpacing="8" ColumnSpacing="14" Margin="0,18,0,0">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="10">
            <Button Grid.Column="0"
                    Content="↑"
                    ToolTip.Tip="Go up"
                    Command="{Binding NavigateUpCommand}"
                    IsVisible="{Binding CanGoUp}"
                    Background="Transparent"
                    Foreground="#EADDFF"
                    FontSize="16"
                    Padding="8,4" />
            <Button Grid.Column="1"
                    Content="↻"
                    ToolTip.Tip="Reload"
                    Command="{Binding ReloadCommand}"
                    Background="Transparent"
                    Foreground="#EADDFF"
                    FontSize="16"
                    Padding="8,4" />
            <ItemsControl Grid.Column="2"
                          ItemsSource="{Binding Breadcrumbs}"
                          VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:BreadcrumbItem">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="›"
                                       FontSize="14"
                                       Foreground="#CAC4D0"
                                       VerticalAlignment="Center" />
                            <Button Content="{Binding Label}"
                                    Command="{Binding $parent[ItemsControl].DataContext.NavigateToBreadcrumbCommand, x:DataType=vm:BucketTabViewModel}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    Foreground="#D0BCFF"
                                    FontSize="14"
                                    Padding="4,2"
                                    Cursor="Hand" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ProgressBar Grid.Column="4"
                         Width="120"
                         Height="4"
                         IsIndeterminate="True"
                         IsVisible="{Binding IsLoadingObjects}"
                         VerticalAlignment="Center" />
        </Grid>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Folders}"
                 Background="Transparent"
                 BorderThickness="0"
                 MinHeight="0"
                 MaxHeight="300">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:FolderItem">
                    <Border Padding="16,10"
                            Margin="0,2"
                            CornerRadius="18"
                            Background="#2B2930"
                            DoubleTapped="OnFolderDoubleTapped">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <TextBlock Text="📁"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DisplayName}"
                                       Foreground="#D0BCFF"
                                       FontSize="14"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="1"
                Height="46"
                Padding="16,0"
                CornerRadius="20"
                Background="#4A4458">
            <Grid ColumnDefinitions="*,120,190,Auto,Auto,Auto" ColumnSpacing="16">
                <TextBlock Grid.Column="0"
                           Text="Object key"
                           FontWeight="SemiBold"
                           Foreground="#EADDFF"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="Size"
                           FontWeight="SemiBold"
                           Foreground="#EADDFF"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="2"
                           Text="Last modified"
                           FontWeight="SemiBold"
                           Foreground="#EADDFF"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="3"
                           Text="Download"
                           FontWeight="SemiBold"
                           Foreground="#EADDFF"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="4"
                           Text="Rename"
                           FontWeight="SemiBold"
                           Foreground="#EADDFF"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="5"
                           Text="Delete"
                           FontWeight="SemiBold"
                           Foreground="#EADDFF"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ListBox Grid.Row="3"
                 Grid.RowSpan="2"
                 ItemsSource="{Binding Files}"
                 SelectedItem="{Binding SelectedObject}"
                 Background="Transparent"
                 BorderThickness="0">
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="2" />
                </Style>
                <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                    <Setter Property="Background" Value="Transparent" />
                </Style>
                <Style Selector="ListBoxItem:selected">
                    <Setter Property="Background" Value="#6750A4" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                    <Setter Property="Background" Value="#6750A4" />
                </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:S3Object">
                    <Border Padding="16,12"
                            Margin="0"
                            CornerRadius="18"
                            Background="#2B2930"
                            Opacity="{Binding IsDeleteMarker, Converter={StaticResource BoolToOpacity}}">
                        <Grid ColumnDefinitions="*,120,190,Auto,Auto,Auto" ColumnSpacing="16">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Key}"
                                       Foreground="#E6E1E5"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                             <TextBlock Grid.Column="1"
                                        Text="{Binding Size, Converter={StaticResource BytesToHumanReadable}}"
                                        Foreground="#CAC4D0"
                                        VerticalAlignment="Center" />
                             <TextBlock Grid.Column="2"
                                        Text="{Binding LastModified, Converter={StaticResource DateTimeFormat}}"
                                       Foreground="#CAC4D0"
                                       VerticalAlignment="Center" />
                            <Button Grid.Column="3"
                                    Content="↓"
                                    ToolTip.Tip="Download"
                                    Command="{Binding $parent[ListBox].DataContext.DownloadObjectCommand, x:DataType=vm:BucketTabViewModel}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    Foreground="#CAC4D0"
                                    Padding="6,2"
                                    FontSize="14"
                                    VerticalAlignment="Center" />
                            <Button Grid.Column="4"
                                    Content="✏️"
                                    ToolTip.Tip="Rename"
                                    Command="{Binding $parent[ListBox].DataContext.RenameObjectCommand, x:DataType=vm:BucketTabViewModel}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    Foreground="#CAC4D0"
                                    Padding="6,2"
                                    FontSize="14"
                                    VerticalAlignment="Center" />
                            <Button Grid.Column="5"
                                    Content="✕"
                                    ToolTip.Tip="Delete"
                                    Command="{Binding $parent[ListBox].DataContext.DeleteObjectCommand, x:DataType=vm:BucketTabViewModel}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent"
                                    Foreground="#CAC4D0"
                                    Padding="6,2"
                                    FontSize="14"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.RowSpan="5"
                Grid.ColumnSpan="2"
                Background="#AA000000"
                IsVisible="{Binding IsConfirmDeleteOpen}">
            <Border Width="420"
                    Padding="24"
                    CornerRadius="24"
                    Background="#211F26"
                    BorderBrush="#49454F"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Delete object"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#E6E1E5" />
                        <TextBlock Text="{Binding ConfirmDeleteMessage}"
                                   FontSize="14"
                                   Foreground="#CAC4D0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Spacing="8" IsVisible="{Binding IsDeleteVersioningChoiceVisible}">
                        <RadioButton Content="Delete latest version only"
                                     IsChecked="{Binding !DeleteAllVersions}"
                                     Foreground="#CAC4D0"
                                     FontSize="13" />
                        <RadioButton Content="Delete all versions"
                                     IsChecked="{Binding DeleteAllVersions}"
                                     Foreground="#CAC4D0"
                                     FontSize="13" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Classes="secondary"
                                Content="Cancel"
                                Command="{Binding CancelDeleteCommand}" />
                        <Button Classes="destructive"
                                Content="Delete"
                                Command="{Binding ConfirmDeleteCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.RowSpan="5"
                Grid.ColumnSpan="2"
                Background="#AA000000"
                IsVisible="{Binding IsUploadPopupOpen}">
            <Border Width="420"
                    Padding="24"
                    CornerRadius="24"
                    Background="#211F26"
                    BorderBrush="#49454F"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Upload file"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#E6E1E5" />
                        <TextBlock Text="Enter a prefix (folder path) or leave empty to upload at the bucket root."
                                   FontSize="13"
                                   Foreground="#CAC4D0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBox Text="{Binding UploadFilePrefix}"
                             PlaceholderText="folder/subfolder/" />

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Classes="secondary"
                                Content="Cancel"
                                Command="{Binding CancelUploadCommand}" />
                        <Button Classes="primary"
                                Content="Upload"
                                Command="{Binding ConfirmUploadCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.RowSpan="5"
                Grid.ColumnSpan="2"
                Background="#AA000000"
                IsVisible="{Binding IsRenamePopupOpen}">
            <Border Width="420"
                    Padding="24"
                    CornerRadius="24"
                    Background="#211F26"
                    BorderBrush="#49454F"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Rename object"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="#E6E1E5" />
                        <TextBlock Text="Enter a new key (path) for the object."
                                   FontSize="13"
                                   Foreground="#CAC4D0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBox Text="{Binding RenameDestinationKey}"
                             PlaceholderText="new/path/file.txt" />

                    <StackPanel Spacing="8" IsVisible="{Binding IsRenameVersioningChoiceVisible}">
                        <RadioButton Content="Rename latest version only"
                                     IsChecked="{Binding !RenameAllVersions}"
                                     Foreground="#CAC4D0"
                                     FontSize="13" />
                        <RadioButton Content="Rename all versions"
                                     IsChecked="{Binding RenameAllVersions}"
                                     Foreground="#CAC4D0"
                                     FontSize="13" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">
                        <Button Classes="secondary"
                                Content="Cancel"
                                Command="{Binding CancelRenameCommand}" />
                        <Button Classes="primary"
                                Content="Rename"
                                Command="{Binding ConfirmRenameCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.RowSpan="5"
                Grid.Column="1"
                Width="280"
                Padding="16"
                CornerRadius="20"
                Background="#2B2930"
                IsVisible="{Binding IsObjectInfoPanelOpen}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Object info"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#E6E1E5"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Content="✕"
                                Command="{Binding CloseObjectInfoPanelCommand}"
                                Background="Transparent"
                                Foreground="#CAC4D0"
                                Padding="4,0"
                                FontSize="16" />
                    </Grid>
                </StackPanel>

                <ScrollViewer DockPanel.Dock="Bottom">
                    <StackPanel Spacing="12" Margin="0,12,0,0">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Key"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#CAC4D0" />
                            <TextBlock Text="{Binding SelectedObject.Key}"
                                       FontSize="13"
                                       Foreground="#E6E1E5"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Text="Size"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#CAC4D0" />
                            <TextBlock Text="{Binding SelectedObject.Size, Converter={StaticResource BytesToHumanReadable}}"
                                       FontSize="13"
                                       Foreground="#E6E1E5" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Text="Last modified"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#CAC4D0" />
                            <TextBlock Text="{Binding SelectedObject.LastModified, Converter={StaticResource DateTimeFormat}}"
                                       FontSize="13"
                                       Foreground="#E6E1E5" />
                        </StackPanel>

                        <StackPanel Spacing="2">
                            <TextBlock Text="ETag"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#CAC4D0" />
                            <TextBlock Text="{Binding SelectedObject.ETag}"
                                       FontSize="13"
                                       Foreground="#E6E1E5"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Spacing="12" IsVisible="{Binding IsVersioned}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="Version ID"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#CAC4D0" />
                                <TextBlock Text="{Binding SelectedObject.VersionId}"
                                           FontSize="13"
                                           Foreground="#E6E1E5"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock Text="Is latest"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#CAC4D0" />
                                <TextBlock Text="{Binding SelectedObject.IsLatest}"
                                           FontSize="13"
                                           Foreground="#E6E1E5" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock Text="Delete marker"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#CAC4D0" />
                                <TextBlock Text="{Binding SelectedObject.IsDeleteMarker}"
                                           FontSize="13"
                                           Foreground="#E6E1E5" />
                            </StackPanel>

                            <StackPanel Spacing="2">
                                <TextBlock Text="Versions"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#CAC4D0" />
                                <TextBlock Text="{Binding SelectedObject.VersionIds.Count}"
                                           FontSize="13"
                                           Foreground="#E6E1E5" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
